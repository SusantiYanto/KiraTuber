{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiraTuber",
  "version": "0.1.0",
  "identifier": "com.pngtuber.mic",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KiraTuber",
        "width": 1140,
        "height": 760,
        "minWidth": 580,
        "minHeight": 460,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-features=CalculateNativeWindowOcclusion"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
